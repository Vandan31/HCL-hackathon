# COMPONENT : answer engine (LLM key pool)
# Copy this file to .env in the repo root (same folder as this file) and paste your keys.
# Either a comma list (below) or one per line: GEMINI_API_KEY_1=..., GEMINI_API_KEY_2=..., GROQ_API_KEY_1=...
# NEVER commit .env (it is in .gitignore). Comma-separate several keys; Gemini keys are tried first.
# Keys from separate projects/accounts add capacity; keys on one account share one quota (D-007).
GEMINI_API_KEYS=
GROQ_API_KEYS=
